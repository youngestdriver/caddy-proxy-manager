{
	admin 0.0.0.0:2019 {
		origins 127.0.0.1:2019 0.0.0.0:2019
	}
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

*.example.com, example.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	# PVE
	@pve host pve.example.com pve.example.net
	handle @pve {
		reverse_proxy https://192.0.2.10:8006 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

